# Modelo do `.env.producao` (copie e preencha; o arquivo real NÃO é versionado).
#   cp producao.env.exemplo .env.producao && chmod 600 .env.producao
# Gere segredos com:  openssl rand -hex 32     (LINK_CHAVE_CIFRA: openssl rand -base64 32)

# Banco. Só letras e números (use `openssl rand -hex 24`), para caber na URL.
POSTGRES_PASSWORD=

# Token do túnel da Cloudflare (Zero Trust > Networks > Tunnels).
TUNNEL_TOKEN=

# Endereço público (HTTPS) e login com Google (redirect: <APP_URL>/api/auth/google/callback).
APP_URL=https://start.convergiadigital.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Obrigatórios em produção.
SESSAO_SEGREDO=
LINK_CHAVE_CIFRA=

# Opcionais (deixe vazio se não usar): ver apps/api/src/config/env.ts.
# Resend (e-mail): defina as duas juntas.
RESEND_API_KEY=
EMAIL_REMETENTE=
