{
  "name": "@convergia/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "tsx watch --env-file-if-exists=../../.env --conditions=source src/server.ts",
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --exclude 'src/**/*.int.test.ts'",
    "test:int": "vitest run int.test",
    "test:coverage": "vitest run --coverage",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev && prisma generate",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "prisma": "7.10.1",
    "tsx": "^4.23.15"
  },
  "dependencies": {
    "@convergia/core": "workspace:*",
    "@fastify/cookie": "^11.1.5",
    "@fastify/multipart": "^10.1.8",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "fastify": "^5.12.8",
    "fastify-plugin": "^6.0.1",
    "openid-client": "^6.8.9",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  }
}
