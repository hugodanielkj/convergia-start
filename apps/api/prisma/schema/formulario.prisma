// Módulo formulario (S2-2, trilha A). Modelo de formulário versionado (RN-15).

// Um por agência. `rascunho` guarda a edição em andamento; null = igual à última versão.
model ModeloFormulario {
  agenciaId    String   @id
  agencia      Agencia  @relation(fields: [agenciaId], references: [id], onDelete: Cascade)
  rascunho     Json?
  atualizadoEm DateTime @updatedAt

  @@map("modelos_formulario")
}

// Imutável depois de publicada: respostas (S2-3) apontam para a versão em que foram dadas.
model VersaoFormulario {
  id              String                    @id @default(uuid(7))
  agenciaId       String
  agencia         Agencia                   @relation(fields: [agenciaId], references: [id], onDelete: Cascade)
  numero          Int
  campos          Json
  publicadaEm     DateTime                  @default(now())
  publicadaPor    String?
  personalizacoes VersaoFormularioCliente[]
  respostas       RespostaFormulario[]

  @@unique([agenciaId, numero])
  @@map("versoes_formulario")
}

// Respostas do cliente (S2-3). Uma por onboarding, presa à versão do modelo vigente quando o
// cliente começou a responder (RN-15). `enviadaEm` nulo = rascunho (RN-18); `fechadaEm` é a
// agência travando as edições (RN-21). `onboardingId` é coluna simples, sem relação.
model RespostaFormulario {
  id              String                   @id @default(uuid(7))
  agenciaId       String
  agencia         Agencia                  @relation(fields: [agenciaId], references: [id], onDelete: Cascade)
  onboardingId    String                   @unique
  versaoId        String
  versao          VersaoFormulario         @relation(fields: [versaoId], references: [id])
  // Preenchido quando o cliente responde perguntas personalizadas (RN-15); `versaoId` fica com a
  // versão padrão de origem.
  versaoClienteId String?
  versaoCliente   VersaoFormularioCliente? @relation(fields: [versaoClienteId], references: [id])
  respostas       Json
  enviadaEm       DateTime?
  fechadaEm       DateTime?
  // Reabertura pela agência (RN-54): libera a edição até o próximo envio, mesmo após a reunião.
  reabertaEm      DateTime?
  criadoEm        DateTime                 @default(now())
  atualizadoEm    DateTime                 @updatedAt

  @@index([agenciaId])
  @@map("respostas_formulario")
}

// Perguntas personalizadas de um cliente (S6-2, RN-15 revisada). Parte da versão padrão `baseId`;
// cada vez que a agência salva, nasce uma versão nova e imutável. Trava quando o cliente começa a
// responder. `onboardingId` é coluna simples, sem relação (apagada na exclusão LGPD).
model VersaoFormularioCliente {
  id           String               @id @default(uuid(7))
  agenciaId    String
  agencia      Agencia              @relation(fields: [agenciaId], references: [id], onDelete: Cascade)
  onboardingId String
  numero       Int
  campos       Json
  baseId       String
  base         VersaoFormulario     @relation(fields: [baseId], references: [id])
  criadaEm     DateTime             @default(now())
  criadaPor    String?
  respostas    RespostaFormulario[]

  @@unique([onboardingId, numero])
  @@index([agenciaId])
  @@map("versoes_formulario_cliente")
}
