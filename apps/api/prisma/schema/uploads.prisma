// Módulo uploads (S2-4, trilha A). Metadados dos arquivos enviados; o conteúdo fica no storage
// (RN-69). `clienteId` é só uma coluna (sem relação) para não alterar o módulo clientes.
model Arquivo {
  id           String   @id @default(uuid(7))
  agenciaId    String
  agencia      Agencia  @relation(fields: [agenciaId], references: [id], onDelete: Cascade)
  clienteId    String
  nomeOriginal String
  tipo         String
  tamanho      Int
  chave        String
  criadoEm     DateTime @default(now())

  @@index([agenciaId, clienteId])
  @@map("arquivos")
}
