// Módulo agenda (S2-5, S2-6, S2-7). Horários "HH:mm" e dias da semana valem no fuso da agência
// (D-14); só os instantes dos agendamentos ficam em UTC. Travas extras (CHECK) estão escritas à
// mão na migração: o Prisma não as declara.
enum TipoAtendimento {
  reuniao
  captacao
}

// Janela semanal em que a agência atende (RN-30). Sem `usuarioId` vale para a agência toda (D-02).
model Disponibilidade {
  id             String          @id @default(uuid(7))
  agenciaId      String
  agencia        Agencia         @relation(fields: [agenciaId], references: [id], onDelete: Cascade)
  usuarioId      String?
  usuario        Usuario?        @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  tipo           TipoAtendimento
  diaSemana      Int // 0 = domingo ... 6 = sábado
  horaInicio     String // "HH:mm"
  horaFim        String // "HH:mm"
  duracaoMinutos Int? // sem valor, vale a duração da ConfigAgencia
  criadoEm       DateTime        @default(now())

  @@index([agenciaId, tipo, diaSemana])
  @@map("disponibilidades")
}

// Período sem atendimento: folga, recesso, feriado estadual ou municipal (RN-44).
model Bloqueio {
  id         String   @id @default(uuid(7))
  agenciaId  String
  agencia    Agencia  @relation(fields: [agenciaId], references: [id], onDelete: Cascade)
  dataInicio DateTime @db.Date
  dataFim    DateTime @db.Date // inclusive
  motivo     String
  criadoEm   DateTime @default(now())

  @@index([agenciaId, dataInicio, dataFim])
  @@map("bloqueios")
}

enum StatusAgendamento {
  agendado
  reagendado
  cancelado
  realizado
  nao_compareceu
}

// Reserva de um horário (RN-33). Os instantes ficam em UTC (D-14). Duas travas no banco, escritas
// à mão na migração porque o Prisma não as declara: um horário não pode ser reservado por duas
// pessoas (exclusão por intervalo, D-11) e um onboarding tem no máximo um agendamento ativo por tipo.
model Agendamento {
  id              String            @id @default(uuid(7))
  agenciaId       String
  agencia         Agencia           @relation(fields: [agenciaId], references: [id], onDelete: Cascade)
  onboardingId    String
  onboarding      Onboarding        @relation(fields: [onboardingId], references: [id], onDelete: Cascade)
  tipo            TipoAtendimento
  inicio          DateTime          @db.Timestamptz(3)
  fim             DateTime          @db.Timestamptz(3)
  status          StatusAgendamento @default(agendado)
  responsavelId   String?
  responsavel     Usuario?          @relation(fields: [responsavelId], references: [id], onDelete: SetNull)
  localOuLink     String?
  eventoExternoId String?
  criadoEm        DateTime          @default(now())
  atualizadoEm    DateTime          @updatedAt

  @@index([agenciaId, inicio])
  @@index([onboardingId, tipo])
  @@map("agendamentos")
}
