# Copie para .env e ajuste. Nunca commite o .env.
NODE_ENV=development
API_PORT=3333
LOG_LEVEL=info

DATABASE_URL=postgresql://convergia:convergia@localhost:5432/convergia
REDIS_URL=redis://localhost:6379

S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=convergia
S3_SECRET_KEY=convergia-dev-secret
S3_BUCKET=convergia-uploads

NEXT_PUBLIC_API_URL=http://localhost:3333

# Seed (pnpm --filter @convergia/api db:seed)
SEED_AGENCIA_NOME=Agência
SEED_ADMIN_EMAIL=admin@exemplo.com
SEED_ADMIN_NOME=Admin

# Só em desenvolvimento, até o login com Google (S1-2): autentica todas as
# requisições como este usuário do seed. Proibido em produção.
AUTH_DEV_USUARIO_EMAIL=

# Proteções do link público (RN-76, decisão 2026-11-14-a-protecoes-link-publico).
# De quem a API aceita o X-Forwarded-For: IPs, sub-redes ou loopback/linklocal/uniquelocal ("nenhum" desliga).
# Em produção, o proxy na frente da web precisa gravar o X-Forwarded-For com o IP do cliente.
CONFIAR_PROXY=loopback,linklocal,uniquelocal
# Limites das rotas /publico/* (0 desliga o contador).
LIMITE_JANELA_SEGUNDOS=60
LIMITE_PUBLICO_POR_IP=300
LIMITE_PUBLICO_POR_TOKEN=300
# Tokens errados (404) por IP antes de bloquear o IP por LIMITE_BLOQUEIO_MINUTOS.
LIMITE_TOKENS_INVALIDOS_POR_IP=20
LIMITE_BLOQUEIO_MINUTOS=15
