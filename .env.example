# Copie para .env e ajuste. Nunca commite o .env.
NODE_ENV=development
API_PORT=3333
LOG_LEVEL=info

DATABASE_URL=postgresql://convergia:convergia@localhost:5432/convergia
REDIS_URL=redis://localhost:6379

S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=convergia
S3_SECRET_KEY=convergia-dev-secret
S3_BUCKET=convergia-uploads

NEXT_PUBLIC_API_URL=http://localhost:3333

# Seed (pnpm --filter @convergia/api db:seed)
SEED_AGENCIA_NOME=Agência
SEED_ADMIN_EMAIL=admin@exemplo.com
SEED_ADMIN_NOME=Admin

# Só em desenvolvimento, até o login com Google (S1-2): autentica todas as
# requisições como este usuário do seed. Proibido em produção.
AUTH_DEV_USUARIO_EMAIL=
