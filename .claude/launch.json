{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@convergia/web", "dev"],
      "port": 3000
    },
    {
      "name": "api",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "DATABASE_URL=postgresql://convergia:convergia@localhost:55432/convergia",
        "pnpm",
        "--filter",
        "@convergia/api",
        "dev"
      ],
      "port": 3333
    }
  ]
}
